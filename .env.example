# Copier vers .env puis remplir. Ne jamais committer .env.

# Domaine public de l'application (Let's Encrypt automatique via Caddy)
DOMAIN=menuiserie-votre-domaine.cm
# Doit correspondre à l'URL d'origine du front (politique CORS)
CORS_ORIGIN=https://menuiserie-votre-domaine.cm

# Base de données PostgreSQL
POSTGRES_USER=mf
POSTGRES_PASSWORD=changez-moi-ici
POSTGRES_DB=monastere

# Durée de session en heures
SESSION_TTL_HOURS=12

# Mot de passe du compte admin créé au tout premier démarrage (à changer ensuite)
BOOTSTRAP_PASSWORD=changez-moi-aussi
